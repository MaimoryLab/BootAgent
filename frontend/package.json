{
  "name": "oneagent-frontend",
  "private": true,
  "version": "0.2.0-dev",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
