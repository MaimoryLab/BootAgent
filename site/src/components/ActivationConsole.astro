        models: (count: number) => `端点返回 ${count} 个示例模型。`,
        model: (id: string) => `已选择模型 ${id}。`,
        ready: "示例环境可进入 Ready。",
        preview: "连接路径可演示，但公开状态仍要求发布候选验证。",
