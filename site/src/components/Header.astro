---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LocaleSwitch from "./LocaleSwitch.astro";
import { bestLocaleFor, localeFromPath, localePath, routeWithoutLocale } from "../i18n";
import { useTranslations } from "../i18n/ui";

const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
const t = useTranslations(locale);
const href = (path: string) => localePath(bestLocaleFor(locale, path), path);
const nav = [
  { path: "downloads/", label: t("nav.downloads") },
  { path: "quickstart/", label: t("nav.quickstart") },
  { path: "agents/", label: t("nav.agents") },
  { path: "providers/", label: t("nav.providers") },
  { path: "security/", label: t("nav.security") },
];
// Compared on the locale-stripped route so /en/agents/ marks the same item as
// /agents/ rather than matching on a substring of the full path.
const route = routeWithoutLocale(pathname);
const active = (path: string) => route === path;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={href("")} aria-label={t("nav.home")}>
      <span class="wordmark-mark"><BrandMark size={24} /></span>
      <span>OneAgent</span>
    </a>
    <nav class="desktop-nav" aria-label={t("nav.primary")}>
      {nav.map((item) => (
        <a href={href(item.path)} aria-current={active(item.path) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="header-link" href={href("enterprise/")}>{t("nav.enterprise")}</a>
      <LocaleSwitch />
      <ThemeToggle />
      <a class="button button-small button-primary" href={href("downloads/")}>{t("cta.download")}</a>
      <details class="mobile-menu">
        <summary aria-label={t("nav.openMenu")}>{t("nav.menu")}</summary>
        <nav aria-label={t("nav.mobile")}>
          {nav.map((item) => <a href={href(item.path)}>{item.label}</a>)}
          <a href={href("enterprise/")}>{t("nav.enterprise")}</a>
          <a href={href("support/")}>{t("nav.support")}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
