---
import AgentMark from "./AgentMark.astro";
import { localeFromPath } from "../i18n";

/* A live, locale- and theme-aware stand-in for the product's environment
   overview. It replaced a single Chinese screenshot that the English page used
   to show verbatim (a Chinese UI on an English page) and that the dark theme
   could only dim, never match. Rendered from markup it follows the page's
   tokens in both schemes and speaks the page's language, and the rows react to
   the pointer the way the real client does. The example versions are illustrative
   constants, not read from the release index. */
const locale = localeFromPath(Astro.url.pathname);
const codexFrom = "0.144.4";
const codexTo = "0.145.0";
const claudeCur = "2.1.220";
const claudeLock = "2.1.217";
const c =
  locale === "en"
    ? {
        figureLabel: "Preview of the OneAgent environment overview, listing each agent with its install and configuration status.",
        windowSub: "AI dev environment",
        oneUpdate: "1 update",
        navActivate: "Activate",
        navWorkspace: "Workspace",
        navOverview: "Overview",
        navProviders: "Providers",
        navTemplates: "Templates",
        overview: "Environment overview",
        notConfigured: "Not configured",
        officialGuide: "Install & sign in the official way",
        installed: "Installed",
        detected: "Detected",
        config: "Configure",
        officialDocs: "Official docs",
        locked: (v: string) => ` (locked ${v})`,
      }
    : {
        figureLabel: "OneAgent 环境总览预览，列出每个 Agent 的安装与配置状态。",
        windowSub: "AI 开发环境",
        oneUpdate: "1 项可更新",
        navActivate: "激活环境",
        navWorkspace: "工作区",
        navOverview: "环境总览",
        navProviders: "Provider",
        navTemplates: "配置模板",
        overview: "环境总览",
        notConfigured: "未配置",
        officialGuide: "按官方方式安装与登录",
        installed: "已安装",
        detected: "已检测到",
        config: "配置",
        officialDocs: "官方文档",
        locked: (v: string) => `（锁定 ${v}）`,
      };

const rows = [
  { id: "codex", name: "Codex", sub: c.notConfigured, delta: `${codexFrom} → ${codexTo}`, chip: "green", chipText: c.installed, action: c.config },
  { id: "claude-code", name: "Claude Code", sub: c.notConfigured, delta: `${claudeCur}${c.locked(claudeLock)}`, chip: "green", chipText: c.installed, action: c.config },
  { id: "cursor", name: "Cursor", sub: c.officialGuide, delta: "", chip: "green", chipText: c.detected, action: c.officialDocs, external: true },
  { id: "opencode", name: "OpenCode", sub: c.notConfigured, delta: "", chip: "", chipText: "", action: c.config },
] as const;
---
<figure class="product-shot" role="img" aria-label={c.figureLabel}>
  <div class="shot-window" data-shot aria-hidden="true">
    <div class="shot-bar">
      <span class="shot-dots"><i /><i /><i /></span>
      <span class="shot-title">OneAgent<em>{c.windowSub}</em></span>
      <span class="shot-pill"><span class="shot-dot" />{c.oneUpdate}</span>
    </div>
    <div class="shot-body">
      <aside class="shot-side">
        <div class="shot-brand">
          <span class="shot-logo" />
          <span>OneAgent<small>{c.windowSub}</small></span>
        </div>
        <span class="shot-cta">{c.navActivate}</span>
        <span class="shot-group">{c.navWorkspace}</span>
        <a class="shot-nav on">{c.navOverview}</a>
        <a class="shot-nav">{c.navProviders}</a>
        <a class="shot-nav">{c.navTemplates}</a>
      </aside>
      <div class="shot-main">
        <div class="shot-main-head">
          <h3>{c.overview}</h3>
          <span class="shot-update-chip">{c.oneUpdate}</span>
        </div>
        <ul class="shot-rows">
          {rows.map((row) => (
            <li class="shot-row">
              <AgentMark id={row.id} name={row.name} size={26} />
              <div class="shot-row-id">
                <strong>{row.name}</strong>
                <span>{row.sub}</span>
              </div>
              <div class="shot-row-tail">
                {row.delta && <span class="shot-delta">{row.delta}</span>}
                {row.chipText && <span class={`chip chip-${row.chip}`}>{row.chipText}</span>}
                <span class:list={["shot-action", { "is-external": "external" in row && row.external }]}>
                  {row.action}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</figure>

<style>
  .shot-window {
    aspect-ratio: 1215 / 690;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--surface-muted);
    border: 1px solid var(--line);
    font-size: 13px;
  }
  .shot-bar {
    flex: none;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .shot-dots { display: inline-flex; gap: 7px; }
  .shot-dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); }
  .shot-dots i:nth-child(1) { background: #ff5f57; }
  .shot-dots i:nth-child(2) { background: #febc2e; }
  .shot-dots i:nth-child(3) { background: #28c840; }
  .shot-title { justify-self: center; font-weight: 650; letter-spacing: -0.01em; color: var(--ink); }
  .shot-title em { margin-left: 8px; font-style: normal; font-weight: 500; color: var(--ink-soft); }
  .shot-pill {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--orange-soft);
    color: var(--orange);
    border: 1px solid var(--chip-orange-line);
    font-size: 11px;
    font-weight: 600;
  }
  .shot-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .shot-body { flex: 1; display: grid; grid-template-columns: 196px 1fr; min-height: 0; }
  .shot-side {
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--surface);
    border-right: 1px solid var(--line);
  }
  .shot-brand { display: flex; align-items: center; gap: 9px; padding: 4px 8px 14px; font-weight: 650; color: var(--ink); }
  .shot-brand small { display: block; font-weight: 500; font-size: 11px; color: var(--ink-soft); }
  .shot-logo {
    width: 24px; height: 24px; border-radius: 7px; flex: none;
    background:
      conic-gradient(from 210deg at 50% 50%, var(--blue), var(--blue-deep), var(--blue));
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .shot-cta {
    text-align: left; padding: 9px 12px; margin-bottom: 12px; cursor: default;
    border: none; border-radius: var(--radius-control);
    background: var(--blue-deep); color: var(--on-accent); font-weight: 600;
  }
  .shot-group { padding: 6px 12px 2px; font-size: 11px; color: var(--ink-faint); text-transform: none; }
  .shot-nav { padding: 8px 12px; border-radius: var(--radius-control); color: var(--ink-soft); cursor: default; }
  .shot-nav.on { background: var(--surface-pressed); color: var(--ink); font-weight: 600; box-shadow: inset 2px 0 0 var(--blue); }
  .shot-main { padding: 18px 22px; display: flex; flex-direction: column; min-height: 0; }
  .shot-main-head { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .shot-main-head h3 { margin: 0; font-size: 19px; letter-spacing: -0.012em; font-weight: 650; color: var(--ink); }
  .shot-update-chip {
    padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600;
    background: var(--orange-soft); color: var(--orange); border: 1px solid var(--chip-orange-line);
  }
  .shot-rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .shot-row {
    display: grid; grid-template-columns: 30px minmax(120px, 0.9fr) auto; align-items: center; gap: 14px;
    padding: 13px 8px; border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-micro) var(--ease-apple), box-shadow var(--dur-micro) var(--ease-apple);
  }
  .shot-row:hover { background: var(--surface); box-shadow: inset 3px 0 0 var(--blue); }
  .shot-row-id strong { display: block; color: var(--ink); letter-spacing: -0.01em; }
  .shot-row-id span { color: var(--ink-soft); font-size: 12px; }
  .shot-row-tail { display: flex; align-items: center; gap: 12px; justify-content: flex-end; white-space: nowrap; }
  .shot-delta { font: 500 12px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--orange); }
  .shot-action { color: var(--ink-soft); font-size: 12px; display: inline-flex; align-items: center; gap: 3px; }
  .shot-action.is-external::after { content: "↗"; font-size: 10px; opacity: 0.7; }
  .shot-row :global(.agent-mark-wrap) { width: 30px; height: 30px; border-radius: 7px; }

  /* A breathing status dot is the one piece of ambient motion in the mock; it
     bows out entirely under reduced motion, matching the particle canvas. */
  @media not (prefers-reduced-motion: reduce) {
    .shot-dot { animation: shot-pulse 2.4s var(--ease-apple) infinite; }
    .shot-row { transition: background-color var(--dur-micro) var(--ease-apple), box-shadow var(--dur-micro) var(--ease-apple), transform var(--dur-micro) var(--ease-apple); }
    .shot-row:hover { transform: translateX(1px); }
  }
  @keyframes shot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.78); }
  }

  /* Below this width the desktop 1215:690 ratio is only ~190px tall while the
     rows need roughly three times that, so holding the ratio would clip most of
     the panel — and clipped content still occupies layout space, letting the
     opaque sidebar's box run down over the section below. The panel sizes to its
     own content here instead, and the sidebar becomes a header strip so the rows
     get the full width. */
  @media (max-width: 680px) {
    .shot-window { aspect-ratio: auto; font-size: 12px; }
    .shot-body { grid-template-columns: 1fr; }
    .shot-side {
      flex-direction: row; align-items: center; gap: 10px;
      padding: 10px 12px; border-right: 0; border-bottom: 1px solid var(--line);
    }
    .shot-brand { padding: 0; flex: 1; }
    .shot-brand small { display: none; }
    .shot-cta { margin-bottom: 0; padding: 7px 12px; font-size: 12px; }
    .shot-group, .shot-nav { display: none; }
    .shot-main { padding: 14px 16px; }
    .shot-main-head h3 { font-size: 16px; }
    .shot-row { grid-template-columns: 26px 1fr auto; gap: 10px; padding: 11px 4px; }
    .shot-row :global(.agent-mark-wrap) { width: 26px; height: 26px; }
    .shot-delta { display: none; }
  }
</style>
