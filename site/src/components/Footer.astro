---
import BrandMark from "./BrandMark.astro";
import { bestLocaleFor, localeFromPath, localePath } from "../i18n";
import { useTranslations } from "../i18n/ui";

const year = new Date().getUTCFullYear();
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const href = (path: string) => localePath(bestLocaleFor(locale, path), path);
// The release index is a single published artifact, not a translated page.
const releaseIndexHref = `${import.meta.env.BASE_URL}release-index.json`;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="wordmark" href={href("")}>
        <span class="wordmark-mark"><BrandMark size={22} /></span>
        <span>OneAgent</span>
      </a>
      <p>{t("footer.tagline")}</p>
      <p class="footer-fine">{t("footer.boundary")}</p>
    </div>
    <div>
      <strong>{t("footer.start")}</strong>
      <a href={href("downloads/")}>{t("footer.downloadCenter")}</a>
      <a href={href("quickstart/")}>{t("nav.quickstart")}</a>
      <a href={href("changelog/")}>{t("nav.changelog")}</a>
    </div>
    <div>
      <strong>{t("footer.capability")}</strong>
      <a href={href("explore/")}>{t("nav.explorer")}</a>
      <a href={href("agents/")}>{t("footer.agentCatalog")}</a>
      <a href={href("providers/")}>{t("footer.providerCatalog")}</a>
      <a href={href("enterprise/")}>{t("nav.enterprise")}</a>
    </div>
    <div>
      <strong>{t("footer.trust")}</strong>
      <a href={href("security/")}>{t("footer.securityPrivacy")}</a>
      <a href={href("support/")}>{t("footer.supportFeedback")}</a>
      <a href={releaseIndexHref}>{t("footer.releaseIndex")}</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} OneAgent</span>
    <span>{t("footer.channel")}</span>
  </div>
</footer>
